# Copy this file to `.env` and adjust if your Postgres differs.
#
# NOTE: drizzle.config.json holds a second copy of this connection string.
# If you change the database name, user, password or port here, update
# drizzle.config.json as well or `npx drizzle-kit push` will target the
# wrong database.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
